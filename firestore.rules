rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /quizzes/{id} { allow read, write: if false; }
    match /quizzes/{quizId}/questions/{questionId} { allow read, write: if false; }
    match /submissions/{id} { allow read, write: if false; }
    match /attempts/{id} { allow read, write: if false; }
    match /users/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read: if false; allow write: if isAdmin(); }
  }
}
